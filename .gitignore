# Private strategy implementations. A new strategy file in this package is
# ignored until it is added to the allowlist below. Samples stay in git.
dogeshtrader/strategy/*
!dogeshtrader/strategy/__init__.py
!dogeshtrader/strategy/base.py
!dogeshtrader/strategy/registry.py
!dogeshtrader/strategy/signals.py
!dogeshtrader/strategy/sample_opening_range.py
!dogeshtrader/strategy/sample_sma_crossover.py

# Tests that exercise a private strategy.
tests/test_intraday_signal.py

