# Zerodha Kite Connect credentials.
# Create an app at https://developers.kite.trade/ to obtain these values.
# NEVER COMMIT the real .env file. Keep API secret offline-only.
KITE_API_KEY=
KITE_API_SECRET=

# Optional pinned user id (useful for sanity-checking the logged in user).
KITE_USER_ID=

# Where DogeshTrader runs. local | staging | production-readonly
DOGESHTRADER_ENV=local

# Optional override for the YAML app config file.
DOGESHTRADER_CONFIG=configs/app.example.yaml

# Optional override for the risk config file.
DOGESHTRADER_RISK_CONFIG=configs/risk.example.yaml

# Postback verification secret (only if you enable Kite postbacks). Leave blank otherwise.
KITE_POSTBACK_SECRET=

# Hosted console. Create the token with `npm run agent:create` in DogeshConsole.
DOGESH_CONSOLE_URL=
DOGESH_CONSOLE_TOKEN=
